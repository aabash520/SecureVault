# Copy this to .env and fill in real values. NEVER commit .env to version control.

# Flask environment: development | production | testing
FLASK_ENV=development

# Required: generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database URL (SQLite for dev, PostgreSQL/MySQL for production)
# SQLite (development):
DATABASE_URL=sqlite:///securevault.db
# PostgreSQL (production example):
# DATABASE_URL=postgresql://vault_user:password@localhost:5432/securevault
# MySQL (production example):
# DATABASE_URL=mysql+pymysql://vault_user:password@localhost:3306/securevault

# Session timeout in minutes (default: 15)
SESSION_LIFETIME_MINUTES=15

# Rate limiter storage (default: in-memory; use Redis for production)
# RATELIMIT_STORAGE_URI=redis://localhost:6379/0
